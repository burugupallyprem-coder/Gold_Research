# ─────────────────────────────────────────────────────────
# OANDA_Backtesting_bot — environment template
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────

# --- OANDA practice (fxTrade Practice) ---
OANDA_API_KEY=your-practice-token-here
OANDA_ACCOUNT_ID=xxx-xxx-xxxxxxxx-xxx
OANDA_ENV=practice            # practice | live   (keep practice)

# --- Instrument & data ---
INSTRUMENT=XAU_USD
ENTRY_TF=M15                  # OANDA granularity for entries
HTF_TF=H4                     # higher-timeframe trend
HISTORY_DAYS=730              # how far back fetch_oanda.py pulls

# --- Strategy / risk (override defaults) ---
CONFIDENCE_THRESHOLD=60
RISK_PER_TRADE_PCT=1.0
MAX_TRADES_PER_DAY=3
MAX_POSITION_USD=1000

# --- Backtest cost model (per side unless noted) ---
SPREAD_USD=0.30               # XAU/USD typical practice spread, in price terms
SLIPPAGE_USD=0.10             # assumed adverse slippage per fill
COMMISSION_PER_TRADE=0.0      # OANDA spot gold is spread-only by default

# --- Slack (for the cloud/live phase, not backtest) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0B88CUAZPD
